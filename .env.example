# --- Backend --------------------------------------------------------------
# Leave these empty to run the built-in demo (mock data in the browser).
# Fill them in (Project Settings -> API in the Supabase dashboard) for live mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force demo mode even when Supabase is configured.
# VITE_DEMO_MODE=true

# --- Maps (all optional) -------------------------------------------------
# Default map centre as "lat,lng" (defaults to Kochi, Kerala).
# VITE_MAP_CENTER=9.9816,76.2999
# Raster tiles (defaults to tile.openstreetmap.org — use your own provider in production).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# Self-hosted OSRM / Nominatim for production traffic.
# VITE_OSRM_URL=https://router.project-osrm.org
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
